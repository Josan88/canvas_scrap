[CANVAS]
# Replace with the full URL to your Canvas instance (e.g., https://yourschool.instructure.com)
API_URL = https://canvas.instructure.com
# Replace with the API Key you generated in your Canvas settings
API_KEY = your_canvas_api_key_here

[STORAGE]
# Local storage only in this branch
STORAGE_TYPE = local
# For local storage: the root directory where files will be stored
LOCAL_ROOT_DIR = ./canvas_sync

# Optional: force regenerate assignment PDFs regardless of Canvas updated_at timestamp
# Use true/false, yes/no, 1/0 (case-insensitive). Default is false.
FORCE_REGENERATE_ASSIGNMENTS=false
# Optional: force regenerate ALL local markdown files (Pages, Assignments, Discussions) 
# regardless of Canvas updated_at timestamp. Use true/false. Default is false.
FORCE_REGENERATE_ALL=false

[LAST_SELECTION]
# Last selected course IDs (comma-separated)
COURSE_IDS = 

[PERFORMANCE]
# Optional performance tuning (safe defaults are used if omitted)
# HTTP request timeout in seconds
REQUEST_TIMEOUT = 20
# Max retries for transient HTTP errors (429/5xx)
MAX_RETRIES = 3
# Exponential backoff factor between retries
BACKOFF_FACTOR = 0.5
# Canvas API page size to reduce pagination roundtrips (Canvas typically allows up to 100)
CANVAS_PER_PAGE = 100
# HTTP connection pool size for Canvas requests
HTTP_POOL_MAXSIZE = 20
# Extract PDFs and transcribe videos on background workers while the sync keeps
# downloading (transcription uses the CPU, PDF extraction mostly the GPU, so they overlap).
# The run waits for them before the summary. false = finish each file before the next.
BACKGROUND_JOBS = true

[PDF_EXTRACTION]
# Device for the hybrid PDF server: auto, cpu, cuda, mps, xpu
DEVICE = cuda
# Convert equations to LaTeX (true/false). Slow on math-heavy lecture slides. Default is true.
ENRICH_FORMULA = true
# Equations sent to the formula model per batch (docling's own default is 5)
FORMULA_BATCH_SIZE = 16
# Max LaTeX tokens per equation; stops unreadable equations looping (docling's default is 2048)
FORMULA_MAX_TOKENS = 512

[EXPORTS]
# Toggle optional exports (true/false). Defaults: most ON, heavy ones OFF.
# Course announcements → Reports/announcements.json
EXPORT_ANNOUNCEMENTS = true
# Discussion topics → Reports/discussion_topics.json
EXPORT_DISCUSSIONS = true
# Course quizzes (classic) → Reports/quizzes.json
EXPORT_QUIZZES = true
# Course enrollments → Reports/enrollments.json
EXPORT_ENROLLMENTS = true
# Course calendar events → Reports/calendar_events.json
EXPORT_CALENDAR_EVENTS = true
# Course groups → Reports/groups.json
EXPORT_GROUPS = true
# Course analytics activity → Reports/analytics_activity.json
EXPORT_ANALYTICS_ACTIVITY = true
# Gradebook history feed → Reports/gradebook_history.json
EXPORT_GRADEBOOK_HISTORY = true
# Potentially heavy: pulls all submissions metadata (not files) → Reports/submissions_summary.json
EXPORT_SUBMISSIONS_SUMMARY = false
# Global inbox conversations (not per-course); can be large → Conversations/conversations.json
EXPORT_INBOX_CONVERSATIONS = false
# Course syllabus → Syllabus/Syllabus.md (HTML body converted to Obsidian Markdown)
EXPORT_SYLLABUS = true
# Canvas-hosted videos embedded in pages/assignments/discussions/announcements/syllabus
# (e.g. lecture recordings) → saved next to the note and embedded as ![[video.mp4]].
# Lecture recordings can be hundreds of MB each. When false, notes keep a link to the Canvas player.
DOWNLOAD_EMBEDDED_VIDEOS = true

[TRANSCRIPTION]
# Transcribe downloaded videos with Whisper (faster-whisper) → <video name>_transcript.md
# next to the video, linked from the note. Needs `pip install faster-whisper` and ffmpeg.
TRANSCRIBE_VIDEOS = true
# Whisper model. small.en: ~7x realtime on an 8-10 core laptop CPU (a 2 h lecture in ~16 min).
# large-v3-turbo: more accurate on hard audio, ~2.5x slower. Others: base.en, medium.en, distil-large-v3.
MODEL = small.en
# auto (NVIDIA GPU if present, else CPU), cpu, cuda. AMD/Intel GPUs are not supported; auto uses the CPU.
DEVICE = auto
# auto → int8 on CPU, float16 on CUDA. Others: int8_float16, float32
COMPUTE_TYPE = auto
# Spoken language code (en, ms, zh, ...), or auto to detect. *.en models are English-only.
LANGUAGE = en
# 1 = greedy (fastest). 5 is Whisper's default; slightly more accurate, about half the speed.
BEAM_SIZE = 1
# CPU threads; 0 = one per physical core
CPU_THREADS = 0
# Speech pieces decoded at once (needs VAD_FILTER). 1 = off. 8 is about 1.5x faster on CPU
# but less accurate: on a test lecture it dropped words (31% word error rate vs 20% with 1,
# both against large-v3-turbo), because each piece is transcribed without the text before it.
BATCH_SIZE = 1
# Skip silence before transcribing (faster, fewer hallucinated lines)
VAD_FILTER = true
# Example text that steers punctuation and spelling; add course terms or names if they come out wrong
INITIAL_PROMPT = Welcome to today's lecture. Let's get started.

[NOTEBOOKLM]
# Toggle whether to automatically sync to NotebookLM after Canvas sync completes (true/false)
SYNC_AFTER_CANVAS = false
# If true, actually upload new/changed sources. If false, only print a preview (dry-run).
APPLY = false
# Toggle whether to sync extracted *_pdf.md files as well
INCLUDE_PDF_EXTRACTS = false
# Toggle whether to sync files inside submission folders
INCLUDE_SUBMISSIONS = false
# Limit the number of pending uploads printed in the console preview
MAX_LIST = 100
# Prefix for NotebookLM notebook titles (e.g. "Canvas Sync - ")
NOTEBOOK_PREFIX = Canvas Sync -
